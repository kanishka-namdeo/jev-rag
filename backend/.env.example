# Jev-RAG backend configuration template
# Copy to .env and fill in real values. NEVER commit real .env files.

# Cloud LLM (OpenAI-compatible endpoint)
JEVRAG_DASHSCOPE_BASE_URL=https://coding-intl.dashscope.aliyuncs.com/v1
JEVRAG_DASHSCOPE_API_KEY=your-api-key-here
# Alternative: an auth-config FILE (JSON with baseUrl/apiKey/token, z-ai-web-dev-sdk
# style) — when set it overrides the two vars above and sends X-Token/X-Z-AI-From
# headers, letting the pipeline run against gateways whose credentials rotate:
# JEVRAG_DASHSCOPE_AUTH_CONFIG=/etc/.z-ai-config
JEVRAG_LLM_MODEL_DEFAULT=qwen3.7-plus
JEVRAG_LLM_MODEL_REASONING=qwen3.6-plus
# Minimum seconds between LLM HTTP attempts (retries included) — set >0 for
# burst-sensitive shared gateways (e.g. 1.5 for the sandbox internal gateway):
# JEVRAG_LLM_MIN_REQUEST_INTERVAL=1.5

# Local Jev-style decision engine (System One)
# NOTE: relative paths resolve against the REPO ROOT regardless of where the
# backend is launched from (backend/app/config.py anchors them), so the values
# below work on any machine and any launch directory. Absolute paths also work.
JEVRAG_JEV_MODEL_DIR=./models/jev-style
JEVRAG_JEV_QUANT=Q4_K_M
JEVRAG_JEV_SCORER=./models/jev-style/build/jev-score
# llama.cpp allocation trim (exact-mode requests only ever use sequences 0/1):
# 2/32 cuts ~306 MB RSS with bit-identical decoding (stock 17/256 sizes for
# many_mode="batched" fan-out, which Jev-RAG does not use).
JEVRAG_JEV_SCORE_N_CTX=8192
JEVRAG_JEV_SCORE_N_SEQ_MAX=2
JEVRAG_JEV_SCORE_N_OUTPUTS_MAX=32

# Embeddings (local, ONNX via fastembed — must be in fastembed's supported list)
# Multilingual default: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384-dim, ~50 langs)
# English-only lighter option: BAAI/bge-small-en-v1.5
JEVRAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Storage (SQLite + ChromaDB + uploads land here; gitignored)
JEVRAG_DATA_DIR=./backend/data   # repo-root relative (anchored in config.py)

# Retrieval knobs
JEVRAG_TOP_K_RETRIEVE=10
JEVRAG_TOP_K_USE=4

# Hybrid v3 pipeline (score-feature escalation gate; see docs/rag-upgrade-2026.md)
# v3 uses a score-feature gate (not Jev absolute sufficiency) to decide easy vs hard path.
# The passage battery ships OFF after full-run evidence showed miscalibrated absolute
# thresholds caused a -20.8pp regression. The no_retrieval fast path needs P >= 0.9 to
# keep factual questions on retrieval.
JEVRAG_HYBRID_EFFORT_ROUTING=true
JEVRAG_JEV_NO_RETRIEVAL_THRESHOLD=0.9
# Escalation gate mode: "features" (default, score-based), "jev" (absolute sufficiency), "none"
# v3 default is "features" — calibrated on eval data using Youden J
JEVRAG_GATE_MODE=features
# Score threshold for the features gate (calibrated on eval data; default is placeholder)
JEVRAG_GATE_SCORE_THRESHOLD=0.6
JEVRAG_HYBRID_MULTISTEP=true
JEVRAG_JEV_MULTISTEP_SUBQUERY_K=6
JEVRAG_JEV_MULTISTEP_MAX_POOL=12
JEVRAG_HYBRID_PASSAGE_BATTERY=false
JEVRAG_JEV_INJECTION_DROP_THRESHOLD=0.9
JEVRAG_JEV_CONTRADICTION_BLOCK_THRESHOLD=0.5
JEVRAG_JEV_EVIDENCE_DROP_THRESHOLD=0.1
JEVRAG_HYBRID_CORRECTIVE_RETRY=true
JEVRAG_HYBRID_BEST_OF_N=true
JEVRAG_HYBRID_CITATION_VERIFY=true
JEVRAG_JEV_CITATION_CONFIDENCE=0.8

# Benchmark judge model (must be independent from generator qwen3.7-plus)
# Default is kimi-k2.5 — a different model family to avoid self-preference bias
JEVRAG_BENCH_JUDGE_MODEL=kimi-k2.5

# Server
JEVRAG_PORT=8000
JEVRAG_LOG_LEVEL=INFO
