# Jev-RAG backend configuration template
# Copy to .env and fill in real values. NEVER commit real .env files.

# Cloud LLM (OpenAI-compatible endpoint)
JEVRAG_DASHSCOPE_BASE_URL=https://coding-intl.dashscope.aliyuncs.com/v1
JEVRAG_DASHSCOPE_API_KEY=your-api-key-here
JEVRAG_LLM_MODEL_DEFAULT=qwen3.7-plus
JEVRAG_LLM_MODEL_REASONING=qwen3.6-plus

# Local Jev-style decision engine (System One)
# Points at the Jev-Style GGUF download dir (see scripts/setup_local_models.sh)
JEVRAG_JEV_MODEL_DIR=./models/jev-style
JEVRAG_JEV_QUANT=Q4_K_M
JEVRAG_JEV_SCORER=./models/jev-style/build/jev-score

# Embeddings (local, ONNX via fastembed — must be in fastembed's supported list)
# Multilingual default: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384-dim, ~50 langs)
# English-only lighter option: BAAI/bge-small-en-v1.5
JEVRAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Storage (SQLite + ChromaDB + uploads land here; gitignored)
JEVRAG_DATA_DIR=./backend/data

# Retrieval knobs
JEVRAG_TOP_K_RETRIEVE=10
JEVRAG_TOP_K_USE=4

# Server
JEVRAG_PORT=8000
JEVRAG_LOG_LEVEL=INFO
